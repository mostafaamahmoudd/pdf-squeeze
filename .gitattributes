*.pdf binary
*.png binary
*.ico binary
*.icns binary

# Preserve verbatim upstream notices and reproducible inventory bytes on Windows.
/third_party/** -text
/THIRD_PARTY_NOTICES.md -text
/LICENSING.md -text
/LICENSE -text
/Cargo.lock -text

# Publication review hashes must survive Windows core.autocrlf checkouts.
/Cargo.toml text eol=lf
/src/gs.rs text eol=lf
/build.rs text eol=lf
/docs/platform-publication.md text eol=lf
